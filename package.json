{
  "name": "mobileide",
  "version": "1.3.28",
  "private": true,
  "description": "MobileIDE - A desktop-class JavaScript development environment for Android",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/mobileide/mobileide.git"
  },
  "scripts": {
    "android": "react-native run-android",
    "postinstall": "node scripts/apply-image-size-security-patch.mjs",
    "ios": "react-native run-ios",
    "lint": "node scripts/run-eslint.mjs",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify:jdk": "node scripts/verify-jdk.mjs",
    "licenses": "node scripts/generate-license-inventory.mjs",
    "licenses:check": "npm run licenses && git diff --exit-code -- release/third-party-licenses.json",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:runtime-ownership": "node scripts/prune-runtime-owned.mjs",
    "check:build-tool-security": "node scripts/verify-build-tool-security.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:development": "npm audit --json",
    "clean": "cd android && ./gradlew clean && cd ..",
    "build:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "prepare:runtime": "bash runtime/scripts/prepare-runtime.sh",
    "test:runtime-policy": "node scripts/test-runtime-policy.mjs",
    "test:exec-android": "node scripts/test-exec-android-host.mjs",
    "test:agent-env-host": "node scripts/test-agent-env-host.mjs",
    "test:shell-navigation-host": "node scripts/test-shell-navigation-host.mjs",
    "test:native-sysroot-host": "node scripts/test-native-sysroot-host.mjs",
    "test:phase2-host": "node scripts/test-phase2-host.mjs",
    "test:workspace-policy-host": "node scripts/test-workspace-policy-host.mjs",
    "test:phase3-host": "node scripts/test-phase3-host.mjs",
    "test:phase4-host": "node scripts/test-phase4-host.mjs",
    "test:phase4-apk": "node scripts/verify-phase4-apk.mjs",
    "test:phase5-host": "node scripts/test-phase5-host.mjs",
    "test:opencode-android": "node scripts/test-opencode-android-host.mjs",
    "test:nano-android": "node scripts/test-nano-android-host.mjs",
    "test:ripgrep-android": "node scripts/test-ripgrep-android-host.mjs",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "package:release": "node scripts/package-release-artifacts.mjs",
    "release:check": "npm run verify:jdk && npm run lint && npm test -- --runInBand && npm run typecheck && npm run licenses:check && npm run check:secrets && npm run check:runtime-ownership && npm run check:build-tool-security && npm run test:runtime-policy && npm run test:exec-android && npm run test:agent-env-host && npm run test:shell-navigation-host && npm run test:native-sysroot-host && npm run test:phase2-host && npm run test:runtime-env-host && npm run test:prefix-retarget && npm run test:workspace-policy-host && npm run test:phase3-host && npm run test:phase4-host && npm run test:phase5-host && npm run test:opencode-android && npm run test:nano-android && npm run test:ripgrep-android && npm run audit:production",
    "prepare:prefix-retarget": "node scripts/generate-prefix-retarget.mjs",
    "test:prefix-retarget": "node scripts/generate-prefix-retarget.mjs --check",
    "test:runtime-env-host": "node scripts/test-runtime-env-host.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "3.1.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-webview": "14.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "monaco-editor": "^0.52.2",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "brace-expansion@<2.0.0": "1.1.18",
    "brace-expansion@5.0.8": "5.0.9",
    "js-yaml@<4.0.0": "3.15.1",
    "js-yaml@>=4.0.0 <5.0.0": "4.3.1",
    "nanoid": "3.3.18"
  }
}
