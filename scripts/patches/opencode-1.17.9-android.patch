+async function openBrowser(url: string) {
+  // This module graph is Android-only: enter the verified APK-native helper
+  // directly. Bun.file().exists() is unreliable for extracted APK libraries
+  // on some Android releases and must not trigger a desktop xdg-open fallback.
+  const sibling = path.join(path.dirname(process.execPath), "libbin_adev_xdg_open.so")
+  const home = process.env.HOME
+  if (!home) throw new Error("Android browser bridge requires HOME")
+  // Pass only the path to an owner-only app-private capability file. Some Bun
+  // standalone builds omit inherited environment entries in native children;
+  // putting the rotating session token in argv would expose it unnecessarily.
+  const capability = path.join(home, ".adev-url-opener-v1")
+  const child = Bun.spawn([sibling, "--capability-file", capability, url], {
+    stdin: "ignore",
+    stdout: "ignore",
+    stderr: "inherit",
+  })
+  const code = await child.exited
+  if (code !== 0) throw new Error(`Android browser bridge exited with code ${code}`)
+}
 
